{
    "name": "asyntai/bagisto-chatbot",
    "type": "bagisto-package",
    "description": "Asyntai - AI Chatbot for Bagisto",
    "keywords": ["bagisto", "chatbot", "ai", "plugin", "asyntai", "ecommerce"],
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Asyntai",
            "email": "hello@asyntai.com",
            "homepage": "https://asyntai.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3"
    },
    "autoload": {
        "psr-4": {
            "Asyntai\\Chatbot\\": "src/"
        }
    },
    "extra": {
